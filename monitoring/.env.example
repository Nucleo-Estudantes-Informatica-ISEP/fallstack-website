# Linux: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999
# Dedicated monitoring login, CONNECT + pg_read_all_stats only, no table grants.
# Never reuse application/migrator/admin credentials. Limit connection timeouts.
METRICS_PG_DSN="host=127.0.0.1 port=5432 user=fallstack_metrics password=replace-me dbname=postgres sslmode=disable connect_timeout=5 statement_timeout=5000"
METRICS_PG_DEV_DATABASE=fallstack_dev
METRICS_PG_MAIN_DATABASE=fallstack_main
METRICS_PG_AUTH_DATABASE=zitadel
# Readiness endpoints must be reachable from the Linux host. No query tokens.
METRICS_MINIO_HEALTH_URL="http://127.0.0.1:9000/minio/health/ready"
METRICS_AUTH_HEALTH_URL="https://auth.nei-isep.org/debug/ready"
# Coolify resource UUIDs (container names) of the dev and main standalone Redis.
# Keep in sync with REDIS_*_CONTAINER in /etc/fallstack/redis-probe.env.
METRICS_REDIS_DEV_CONTAINER=replace-with-dev-redis-uuid
METRICS_REDIS_MAIN_CONTAINER=replace-with-main-redis-uuid
