[Unit]
Description=Fallstack daily CV retention and orphan cleanup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/fallstack
# Operator installs a restricted env file in this checkout. Never print it.
ExecStart=/usr/bin/docker compose --env-file /etc/fallstack/retention.env -f docker-compose.retention.yml run --rm --no-deps storage-cleanup node --conditions=react-server --import tsx scripts/storage-cleanup.ts
# An audit is not a successful retention run; fail until apply is opted in.
ExecStartPost=/bin/sh -c 'echo "ERROR: retention is audit-only; install the reviewed apply.conf drop-in before stopping the existing daemon" >&2; exit 1'
TimeoutStartSec=1h
