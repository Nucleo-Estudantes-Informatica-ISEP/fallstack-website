generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  // Stable external identity from ZITADEL's OIDC `sub`. User.id remains an
  // application-owned UUID so all profile/domain foreign keys stay IdP-agnostic.
  zitadelUserId String?    @unique
  // Null for an admin-only account (no Student/Employee profile - see
  // adminRole below). Non-null for every self-service/admin-provisioned
  // Student or Employee account.
  role          Role?
  email         String     @unique
  // Cached/local presentation of the global NEI admin grant. Runtime
  // authorization is derived from the signed ZITADEL-backed app session.
  adminRole     AdminRole?
  // Display name for an admin-only account - Student/Employee have their
  // own `name` on their respective profile table instead.
  name          String?
  // Gates this application's access without disabling the shared AuthNEI
  // identity for the user's other NEI applications.
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  student   Student?
  employee  Employee?
  interests Interest[]
}

model Student {
  id   String @id @db.Uuid
  user User   @relation(fields: [id], references: [id], onDelete: Cascade)

  code         String    @unique
  name         String
  bio          String?
  year         Year
  // avatar/cv are bare Supabase Storage file IDs with no DB-level integrity
  // (no referential constraint, no cascade cleanup) - the root cause of the
  // orphaned-file GC job tracked separately in #37. Consider an Upload
  // tracking table if that gap needs closing; until then the GC job is the
  // only thing keeping storage in sync with these columns.
  cv           String?
  // Set on every successful CV upload - updatedAt isn't CV-specific (bumped
  // by any profile edit), so the twice-yearly retention purge (#286) needs
  // its own clock to tell which CVs are genuinely older than 6 months. Not
  // modified by the purge itself: it stays as the last-upload timestamp
  // even after `cv` is cleared (see cvPurgedAt below).
  cvUploadedAt DateTime?
  // Stamped by the retention purge when it nulls out `cv`; drives the
  // profile "your CV was removed" banner. Cleared back to null on the next
  // successful upload, which also refreshes cvUploadedAt above.
  cvPurgedAt   DateTime?
  linkedin     String?
  github       String?
  avatar       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  actionCompletions ActionCompletion[]
  savedByEmployees  SavedStudent[]
}

model Company {
  id String @id @default(uuid()) @db.Uuid

  name      String   @unique
  avatar    String?
  website   String?
  // Gates public-roster visibility: self-registered companies (via the
  // signup flow) default to inactive until an admin vets and approves
  // them for the public site, independent of their recruiting account.
  active    Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Legacy plaintext compatibility field. Direct-ZITADEL onboarding uses
  // employeeInviteCodeHash; drop `code` only after the cutover is verified.
  code                        String?   @unique
  employeeInviteCodeHash      String?   @unique
  employeeInviteCodeUpdatedAt DateTime?

  rank   CompanyRank @relation(fields: [rankId], references: [id])
  rankId String      @db.Uuid

  profile      CompanyProfile?
  displayStyle CompanyDisplayStyle?
  interests    Interest[]

  employees     Employee[]
  savedStudents SavedStudent[]
  actions       Action[]
}

// Replaces the fixed Tier enum so a new rank is a data change, not a code
// change - see #280.
model CompanyRank {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique
  order Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies Company[]
  style     CompanyRankStyle?
}

// 1:1 companion to CompanyRank - was the hardcoded `Record<CompanyTier, ...>`
// maps in domain/company/services/tier-styling.ts and
// company-tier-access.ts.
model CompanyRankStyle {
  id     String      @id @default(uuid()) @db.Uuid
  rank   CompanyRank @relation(fields: [rankId], references: [id], onDelete: Cascade)
  rankId String      @unique @db.Uuid

  gradientFromColor String
  gradientFromStop  String
  gradientToColor   String
  gradientToStop    String
  // Whether this rank gets an internal /company/[name] page at all (vs.
  // always linking out to the company's own website).
  hasInternalPage   Boolean @default(false)
  // Whether the internal page's promo-video section renders (was
  // `tier === COMPANY_TIER.DIAMOND` hardcoded in CompanyInfo).
  showsPromoVideo   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 1:1 companion to Company - the rich per-company modal/profile content
// that used to live in src/edition/{Diamond,Gold}Companies.tsx. Presentation
// fields are kept off Company itself so the roster table stays lean.
model CompanyProfile {
  id        String  @id @default(uuid()) @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String  @unique @db.Uuid

  // Plain text, not JSX - was ReactNode in ModalInformation.bodyText.
  bodyText    String
  videoTitle  String?
  videoHref   String?
  // { twitter?, facebook?, instagram?, youtube?, linkedin? } - small,
  // bounded/ordered blob, no need to query by individual link.
  socialLinks Json?
  // [{ iconName, description, className? }][] - iconName resolves through
  // a fixed icon-name -> component lookup on render, since a react-icons
  // component reference can't round-trip through JSON.
  facts       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 1:1 companion to Company - logo sizing, was the `logoWidth`/`logoHeight`/
// `className` fields on src/edition/CompanyEditionContent.ts.
model CompanyDisplayStyle {
  id        String  @id @default(uuid()) @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String  @unique @db.Uuid

  logoWidth  Int?
  logoHeight Int?
  className  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id   String @id @db.Uuid
  user User   @relation(fields: [id], references: [id], onDelete: Cascade)

  name      String
  linkedin  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String  @db.Uuid

  savedStudents SavedStudent[]

  @@index([companyId])
}

model Action {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String
  points      Int
  altText     String?
  isLive      Boolean  @default(false)
  isVisible   Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  // Nullable: most actions (profile/CV/LinkedIn, talks) aren't booth
  // actions at all. Replaces edition/actions.ts's name-matched
  // boothActions map - see #280.
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?  @unique @db.Uuid

  actionCompletions ActionCompletion[]
}

model ActionCompletion {
  id          String   @id @default(uuid()) @db.Uuid
  completedAt DateTime @default(now())

  action  Action  @relation(fields: [actionId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  actionId  String @db.Uuid
  studentId String @db.Uuid

  @@unique([actionId, studentId])
}

model Interest {
  id   String @id @default(uuid()) @db.Uuid
  name Json

  users     User[]
  // Mirrors the existing User.interests implicit m:n - see #280.
  companies Company[]
}

// Unlike Company, sponsors have no self-registration path - every row is
// admin-created, so there's no untrusted-signup case to gate behind
// active=false; it defaults to true.
model Sponsor {
  id String @id @default(uuid()) @db.Uuid

  name      String   @unique
  logo      String
  website   String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per timetable entry. `day` is a plain 1-indexed slot (1, 2, ...)
// rather than an enum or a real date, matching how ScheduleDays.ts (the
// static config this replaces) grouped entries - just an array of arrays,
// no calendar date attached. startTime/endTime are "HH:MM" 24h strings
// rather than a time type: this is a per-edition recurring schedule, not
// tied to a real date, and plain zero-padded strings sort/compare
// correctly for the admin board's chronological-overlap check
// (domain/schedule/scheduleValidation.ts) without needing to parse them.
model ScheduleEvent {
  id String @id @default(uuid()) @db.Uuid

  day       Int
  order     Int      @default(0)
  startTime String
  endTime   String
  activity  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([day, order], map: "ScheduleEvent_day_order_key")
}

model FaqEntry {
  id String @id @default(uuid()) @db.Uuid

  question  Json
  answer    Json
  order     Int      @unique(map: "FaqEntry_order_key") @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavedStudent {
  studentId  String   @db.Uuid
  employeeId String   @db.Uuid
  companyId  String   @db.Uuid
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  savedBy    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  comment    String?

  @@id([studentId, employeeId])
  @@unique([studentId, companyId])
}

enum Role {
  STUDENT
  EMPLOYEE
}

enum AdminRole {
  // Manages Students/Employees and the rest of today's admin backoffice.
  ADMIN
  // Everything ADMIN can do, plus creating/editing/deactivating other admin
  // accounts.
  SUPER_ADMIN
}

// Prisma-side identifiers are decoupled from the stored/display label via
// @map so the DB keeps the existing Portuguese strings with no data
// migration; application/dto/studentDto.ts and application/services/
// studentService.ts convert to/from src/domain/Student/year.ts's labels at
// the Prisma boundary - everything else keeps working with plain strings.
enum Year {
  LICENCIATURA_1 @map("1º Ano Licenciatura")
  LICENCIATURA_2 @map("2º Ano Licenciatura")
  LICENCIATURA_3 @map("3º Ano Licenciatura")
  MESTRADO_1     @map("1º Ano Mestrado")
  MESTRADO_2     @map("2º Ano Mestrado")
}
