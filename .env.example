NEXT_PUBLIC_BASE_URL="https://your-site-domain.com/api"

# Postgres (local Supabase docker defaults)
# DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"
# DIRECT_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# Supabase hosted DB (use the project’s connection strings)
DATABASE_URL="postgresql://postgres:<password>@<your-host>.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:<password>@<your-host>.supabase.co:5432/postgres?sslmode=require"

# Supabase project configuration (hosted)
SUPABASE_URL="https://<your-host>.supabase.co"                          # service URL (server)
SUPABASE_KEY="service_role_key_here"                                   # service role key (server-only)
NEXT_PUBLIC_SUPABASE_URL="https://<your-host>.supabase.co"             # public URL (client/server)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="anon_key_here"                   # anon key (client/server SSR)

# Optional overrides for docker compose
# SUPABASE_PUBLIC_URL="http://127.0.0.1:54321"
# SUPABASE_SITE_URL="http://localhost:3000"
# SUPABASE_MAIL_AUTOCONFIRM=true

JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters-long"
NODE_ENV="development"

# Observability (optional)
# Public DSN used by browser, server, and edge Sentry SDKs.
# NEXT_PUBLIC_SENTRY_DSN="https://public-key@o0.ingest.sentry.io/project-id"
# Sentry organization/project slugs used during source-map upload.
# SENTRY_ORG="your-organization-slug"
# SENTRY_PROJECT="your-project-slug"
# Secret build-only token. Use CI secrets or Docker BuildKit secrets; never commit it.
# SENTRY_AUTH_TOKEN="sntrys_your_token"
# Pino minimum level: trace, debug, info, warn, error, fatal, or silent.
# LOG_LEVEL="debug"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="test"
