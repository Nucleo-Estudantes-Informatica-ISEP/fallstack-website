# `docker-compose.app.yml` derives this from Coolify's SERVICE_URL_WEB and
# appends /api. For direct `pnpm dev`, env.client.ts defaults to localhost:3000/api.
# NEXT_PUBLIC_BASE_URL="http://localhost:3000/api"

# ZITADEL project containing cross-application roles such as `admin`.
# Set this to enable the shared role/audience scopes during AuthNEI login.
# NEXT_PUBLIC_AUTHNEI_GLOBAL_PROJECT_ID="123456789012345678"

# Postgres (local Supabase docker defaults)
# DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"
# DIRECT_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# Supabase hosted DB (use the project’s connection strings)
DATABASE_URL="postgresql://postgres:<password>@<your-host>.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:<password>@<your-host>.supabase.co:5432/postgres?sslmode=require"

# Supabase project configuration (hosted)
NEXT_PUBLIC_SUPABASE_URL="https://<your-host>.supabase.co"             # public URL (client/server)
NEXT_PUBLIC_SUPABASE_ANON_KEY="anon_key_here"                          # anon key (client/server SSR)
SUPABASE_SERVICE_ROLE_KEY="service_role_key_here"                      # service role key (server-only)

# Optional overrides for docker compose
# SUPABASE_PUBLIC_URL="http://127.0.0.1:54321"
# SUPABASE_SITE_URL="http://localhost:3000"
# SUPABASE_MAIL_AUTOCONFIRM=true

JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters-long"
NODE_ENV="development"

# Observability (optional)
# Public DSN used by browser, server, and edge Sentry SDKs. Works with
# sentry.io or any Sentry-compatible backend (e.g. self-hosted GlitchTip).
# NEXT_PUBLIC_SENTRY_DSN="https://public-key@o0.ingest.sentry.io/project-id"
# Sentry organization/project slugs used during source-map upload.
# SENTRY_ORG="your-organization-slug"
# SENTRY_PROJECT="your-project-slug"
# Only needed for a self-hosted Sentry-compatible backend (e.g. GlitchTip) -
# controls where source maps are uploaded during build. Leave unset to
# upload to sentry.io.
# SENTRY_URL="https://glitchtip.your-domain.example/"
# Secret build-only token. Use CI secrets or Docker BuildKit secrets; never commit it.
# SENTRY_AUTH_TOKEN="sntrys_your_token"
# Pino minimum level: trace, debug, info, warn, error, fatal, or silent.
# LOG_LEVEL="debug"
# External GlitchTip/Sentry dashboard the admin backoffice's Logs nav item links to.
# NEXT_PUBLIC_LOGS_DASHBOARD_URL="https://glitchtip.example.com/org-slug/issues"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="test"
