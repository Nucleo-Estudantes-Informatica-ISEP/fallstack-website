# Public API base for native development. In Coolify/docker-compose this is
# derived from SERVICE_URL_WEB + /api when left unset.
NEXT_PUBLIC_BASE_URL="http://localhost:3000/api"

# Postgres
# Per Node process; URL pool params are overridden. Cleanup/jobs use a fixed pool of 1.
# Each web process also reserves one separate readiness connection.
# Shared-cluster budget and rollout limits: docs/operations/postgres-connections.md
PRISMA_CONNECTION_LIMIT="3"
PRISMA_POOL_TIMEOUT_SECONDS="5"
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"
# Required by Prisma locally; use DATABASE_URL's value for local development.
# docker-compose falls back to DATABASE_URL when DIRECT_URL is not supplied.
DIRECT_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# Coolify Compose only: each environment uses its own standalone Redis resource
# in a dedicated destination network. Set these runtime-only (not build-time).
# Never reuse dev values in main; ADR 0021 supersedes the ADR 0015 Compose Redis.
# Uploads require authenticated Redis and an explicit prefix; missing/unavailable
# Redis fails closed with 503. No per-process fallback. /api/ready probes the URL.
# redis:// is for the private Docker bridge/loopback; rediss:// verifies TLS using
# system CAs (NODE_EXTRA_CA_CERTS may supply a private CA). No URL query options.
# REDIS_NETWORK_NAME remains Compose-only. Never run local checks on shared data.
REDIS_URL="redis://default:replace-with-local-redis-secret@127.0.0.1:6379"
REDIS_KEY_PREFIX="fallstack:local:"
# Coolify overrides both values, runtime-only; every copy must agree:
# REDIS_URL="redis://default:<password>@<redis-container-name>:6379"
# REDIS_NETWORK_NAME="<docker network name of the Redis destination>"
# REDIS_KEY_PREFIX="fallstack:dev:"
# Use REDIS_KEY_PREFIX="fallstack:main:" in the main Coolify resource.

# Local MinIO; deployed environments use distinct scoped credentials.
# Coolify Compose shares this override between web and cleanup; when unset it
# defaults to the shared MinIO service hostname.
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="fallstack_local"
S3_SECRET_ACCESS_KEY="replace-with-local-minio-secret"
S3_BUCKET_AVATARS="fallstack-dev-avatars"
S3_BUCKET_LOGOS="fallstack-dev-logos"
S3_BUCKET_CVS="fallstack-dev-cvs"
# Scheduled worker: dry-run until operators review candidates; then apply.
# Manual pnpm storage:cleanup always dry-runs unless --apply is given.
STORAGE_CLEANUP_MODE="dry-run"

# Local development secrets. Coolify generates these automatically when they
# are left unset in deployed environments.
JWT_SECRET="local-jwt-secret-change-me-32-characters"
AUTH_SECRET="local-auth-secret-change-me-32-characters"

# Direct AuthNEI / ZITADEL OIDC
AUTH_ISSUER_URL="https://auth.nei-isep.org"
AUTH_PROJECT_ID="fallstack_project_id"
AUTH_GLOBAL_PROJECT_ID="nei_global_project_id"
AUTH_CLIENT_ID="fallstack_oidc_client_id"
AUTH_CLIENT_SECRET="fallstack_oidc_client_secret"
# In Coolify, scopes and role-claim names are derived from the project IDs when
# left unset. The Fallstack project audience exposes `employee`; the global
# project audience exposes the shared `admin` role.
# Disable the Fallstack project's automatic role assertion in ZITADEL; request
# roles through the scopes below. See docs/operations/zitadel-roles.md.
AUTH_SCOPES="openid email profile urn:zitadel:iam:org:projects:roles urn:zitadel:iam:org:project:id:fallstack_project_id:aud urn:zitadel:iam:org:project:id:nei_global_project_id:aud"
AUTH_ROLE_CLAIM="urn:zitadel:iam:org:project:fallstack_project_id:roles"
AUTH_GLOBAL_ROLE_CLAIM="urn:zitadel:iam:org:project:nei_global_project_id:roles"
# Native pnpm dev runs on port 3000. In Coolify these two derive automatically
# from SERVICE_URL_WEB when unset. Register the exact callback and post-logout
# URLs in the AuthNEI application; a missing logout URI causes invalid_request.
AUTH_REDIRECT_URI="http://localhost:3000/api/auth/callback/zitadel"
AUTH_POST_LOGOUT_REDIRECT_URI="http://localhost:3000"
ZITADEL_ORG_ID="nei_org_id"
ZITADEL_ROLE_ASSIGNER_TOKEN="fallstack_role_assigner_pat"

# Google Wallet. Non-Wallet dev/staging/CI installs must explicitly opt out below.
# The service-account value is the complete JSON key, base64 encoded only to
# make multiline secret transport reliable. Base64 does not make it non-secret.
# Set true only for environments that have never issued a Wallet pass; keep
# all three credentials unset. Otherwise student deletion fails closed with 503.
# Clear this declaration before enabling Wallet. Never opt out after issuance.
GOOGLE_WALLET_NEVER_ENABLED="false"
# Opt-in: one-slot deletion can block all other requests during Google I/O.
GOOGLE_WALLET_ALLOW_SINGLE_CONNECTION_DELETE="false"
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_CLASS_ID=""
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_B64=""

NODE_ENV="development"
# Set to true only in the dev deployment for a full website showcase.
SHOWCASE_FULL_WEBSITE="false"

# Observability (optional)
# NEXT_PUBLIC_SENTRY_DSN="https://public-key@o0.ingest.sentry.io/project-id"
# SENTRY_ORG="your-organization-slug"
# SENTRY_PROJECT="your-project-slug"
# SENTRY_URL="https://glitchtip.your-domain.example/"
# SENTRY_AUTH_TOKEN="sntrys_your_token"
# LOG_LEVEL="debug"
# Private Prometheus listener; never publish/proxy port 9464.
# Set dev/main explicitly; NODE_ENV=production applies to both deployments.
# METRICS_ENABLED="true"
# METRICS_ENVIRONMENT="dev"
# METRICS_HOST="0.0.0.0" # Docker private bridge; native default is loopback.
# NEXT_PUBLIC_LOGS_DASHBOARD_URL="https://glitchtip.example.com/org-slug/issues"

# Seed-only development values. These do not create AuthNEI credentials.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="test"

# Optional staging-only event-readiness harness (tests/e2e/README.md)
# CONFIRM_NON_PRODUCTION="yes"
# E2E_BASE_URL="https://staging.example.org"
# STAGING_BASE_URL="https://staging.example.org"
# ACTION_ID="synthetic-staging-action-id"
# READINESS_MUTATIONS="no"
# READINESS_LOAD="no"
# READINESS_RATE_LIMIT="no"
# K6_PROFILE="smoke"
# E2E_STUDENT_STORAGE_STATE="tests/e2e/.staging-student.json"
# E2E_EMPLOYEE_STORAGE_STATE="tests/e2e/.staging-employee.json"
# E2E_ADMIN_STORAGE_STATE="tests/e2e/.staging-admin.json"
# E2E_SUPER_ADMIN_STORAGE_STATE="tests/e2e/.staging-super-admin.json"
# E2E_ALLOW_UPLOADS="yes"
# E2E_VERIFY_UPLOAD_LIMITS="yes"

# Optional overrides for docker-compose.local.yml. The Compose stack otherwise
# uses isolated service defaults and ignores the host-facing DATABASE_URL,
# REDIS_URL and S3_ENDPOINT values above. MinIO credentials are embedded in an
# MC_HOST URL, so use URL-safe characters if changing the defaults.
# FALLSTACK_LOCAL_POSTGRES_PASSWORD="postgres"
# FALLSTACK_LOCAL_REDIS_PASSWORD="replace-with-local-redis-secret"
# FALLSTACK_LOCAL_MINIO_ROOT_USER="fallstack_local"
# FALLSTACK_LOCAL_MINIO_ROOT_PASSWORD="replace-with-local-minio-secret"
# FALLSTACK_LOCAL_POSTGRES_PORT="54322"
# FALLSTACK_LOCAL_REDIS_PORT="6379"
# FALLSTACK_LOCAL_MINIO_API_PORT="9000"
# FALLSTACK_LOCAL_MINIO_CONSOLE_PORT="9001"
# FALLSTACK_LOCAL_WEB_PORT="4000"
# FALLSTACK_LOCAL_GOOGLE_WALLET_NEVER_ENABLED="true"
# Override these only when registering a non-default OIDC callback:
# FALLSTACK_LOCAL_AUTH_REDIRECT_URI="http://localhost:4000/api/auth/callback/zitadel"
# FALLSTACK_LOCAL_AUTH_POST_LOGOUT_REDIRECT_URI="http://localhost:4000"
